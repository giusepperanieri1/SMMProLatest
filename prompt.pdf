### AI Service Main API (main.py)
```python
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import uvicorn
import asyncio
from video_processor.auto_crop import AutoCropper
from video_processor.subtitle_generator import SubtitleGenerator
from content_generator.caption_ai import CaptionGenerator
from content_generator.hashtag_generator import HashtagGenerator
from utils.storage_manager import StorageManager

app = FastAPI(title="SMMPro AI Services", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Initialize AI services
auto_cropper = AutoCropper()
subtitle_gen = SubtitleGenerator()
caption_gen = CaptionGenerator()
hashtag_gen = HashtagGenerator()
storage = StorageManager()

@app.post("/process-video")
async def process_video(
    file: UploadFile = File(...),
    platforms: list[str] = ["instagram", "tiktok", "youtube"]
):
    try:
        # Save uploaded file
        video_path = await storage.save_upload(file)
        
        # Process video for different platforms
        results = {}
        for platform in platforms:
            # Auto-crop for platform
            cropped_video = await auto_cropper.crop_for_platform(video_path, platform)
            
            # Generate subtitles
            subtitles = await subtitle_gen.generate(video_path)
            
            # Generate captions and hashtags
            captions = await caption_gen.generate_for_platform(video_path, platform)
            hashtags = await hashtag_gen.generate_for_platform(video_path, platform)
            
            results[platform] = {
                "video_url": cropped_video,
                "subtitles": subtitles,
                "captions": captions,
                "hashtags": hashtags
            }
        
        return {"success": True, "results": results}
    
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/generate-caption")
async def generate_caption(video_url: str, platform: str, style: str = "engaging"):
    try:
        captions = await caption_gen.generate_for_platform(video_url, platform, style)
        return {"success": True, "captions": captions}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)
```

